<Window
    x:Class="KeyBoopWin.TranslatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="🌐 Переводчик">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <TextBlock Text="🌐 Переводчик" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Быстрый перевод между русским и английским" 
                       Foreground="Gray" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Направление перевода (по центру всего окна) -->
        <TextBlock x:Name="DirectionLabel" 
                   Grid.Row="1" 
                   Text="ru Русский ➔ en English" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="#0078D4"
                   Margin="0,10,0,15"/>

        <!-- Текстовые поля + заголовки + кнопка смены (ВСЁ В ОДНОМ GRID!) -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Заголовки полей (Row 0) -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Исходный текст:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Перевод:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,8"/>

            <!-- Левое поле (Row 1, Column 0) -->
            <TextBox Grid.Row="1" Grid.Column="0" x:Name="InputText" 
                     PlaceholderText="Введите текст для перевода..."
                     TextWrapping="Wrap" 
                     AcceptsReturn="True"
                     FontSize="14"
                     Background="#2D2D2D"
                     Foreground="White"
                     Margin="0,0,10,0"/>

            <!-- Кнопка смены (Row 1, Column 1) - строго по центру! -->
            <Button Grid.Row="1" Grid.Column="1" Content="⇄" Click="SwapLanguages_Click" 
                    Width="50" Height="50" 
                    FontSize="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    ToolTipService.ToolTip="Поменять языки и текст местами"
                    Background="#0078D4" Foreground="White"
                    Margin="10,0,10,0"/>

            <!-- Правое поле (Row 1, Column 2) -->
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="OutputText" 
                     PlaceholderText="Здесь появится перевод..."
                     TextWrapping="Wrap" 
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     FontSize="14"
                     Background="#1E1E1E"
                     Foreground="#00FF00"
                     Margin="10,0,0,0"/>
        </Grid>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="📋 Копировать текст" Click="CopyInput_Click" Width="160" Height="40"/>
            <Button Content="🌐 Перевести" Click="Translate_Click" Width="140" Height="40" Background="#0078D4" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="🗑️ Очистить всё" Click="ClearAll_Click" Width="140" Height="40"/>
            <Button Content="📋 Копировать перевод" Click="CopyTranslation_Click" Width="190" Height="40"/>
        </StackPanel>
    </Grid>
</Window>