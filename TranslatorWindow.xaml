<Window
    x:Class="KeyBoopWin.TranslatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KeyBoopWin">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <TextBlock Text="🌐 Переводчик" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Быстрый перевод между русским и английским + Азбука Морзе и Двоичный код" 
                       Foreground="Gray" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Направление -->
        <TextBlock x:Name="DirectionLabel" 
                   Grid.Row="1" 
                   Text="ru Русский ➔ en English + 📡 Морзе + 💻 Binary" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="#0078D4"
                   Margin="0,5,0,15"/>

        <!-- ОСНОВНОЙ GRID -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Row 0: Текстовые поля -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Кнопки управления -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Азбука Морзе -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Двоичный код -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ВЕРХНИЙ РЯД: Текстовые поля -->
            <Border Grid.Row="0" Grid.Column="0" Background="#1E1E1E" Padding="15" CornerRadius="8" Margin="0,0,10,10">
                <StackPanel Spacing="10">
                    <TextBlock Text="Исходный текст:" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBox x:Name="InputText" 
                             PlaceholderText="Введите текст, Морзе или 01001000..."
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"
                             FontSize="14"
                             Background="#2D2D2D"
                             Foreground="White"
                             MinHeight="120"
                             TextChanged="InputText_TextChanged"/>
                    <Button Content="📋 Копировать текст" Click="CopyInput_Click" 
                            Height="35" Padding="15,5" Background="#2D2D2D" Foreground="White"
                            HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Button Grid.Row="0" Grid.Column="1" Content="⇄" Click="SwapLanguages_Click" 
                    Width="50" Height="50" 
                    FontSize="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#0078D4" Foreground="White"
                    Margin="10,0,10,10"/>

            <Border Grid.Row="0" Grid.Column="2" Background="#1E1E1E" Padding="15" CornerRadius="8" Margin="10,0,0,10">
                <StackPanel Spacing="10">
                    <TextBlock Text="Перевод:" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBox x:Name="OutputText" 
                             PlaceholderText="Здесь появится перевод..."
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontSize="14"
                             Background="#2D2D2D"
                             Foreground="#00FF00"
                             MinHeight="120"/>
                    <Button Content="📋 Копировать перевод" Click="CopyTranslation_Click" 
                            Height="35" Padding="15,5" Background="#2D2D2D" Foreground="White"
                            HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- СРЕДНИЙ РЯД: Кнопки управления -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                        Orientation="Horizontal" Spacing="10" 
                        HorizontalAlignment="Center" Margin="0,5,0,15">
                <Button Content="🌐 Перевести" Click="Translate_Click" Width="140" Height="40" Background="#0078D4" Foreground="White" FontWeight="SemiBold"/>
                <Button Content="🗑️ Очистить всё" Click="ClearAll_Click" Width="140" Height="40"/>
            </StackPanel>

            <!-- РЯД: Азбука Морзе -->
            <Border Grid.Row="2" Grid.Column="0" Background="#1E1E1E" Padding="15" CornerRadius="8" Margin="0,0,10,10">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="LeftMorseLabel" Text="📡 Азбука Морзе (Русский)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBox x:Name="LeftMorseText" 
                             PlaceholderText="Здесь появится код Морзе..."
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontSize="13"
                             Background="#2D2D2D"
                             Foreground="#FFD700"
                             FontFamily="Consolas"
                             Height="70"/>
                    <Button Content="📋 Копировать Морзе" Click="CopyLeftMorse_Click" 
                            Height="35" Padding="15,5" Background="#2D2D2D" Foreground="White" 
                            HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Background="#1E1E1E" Padding="15" CornerRadius="8" Margin="10,0,0,10">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="RightMorseLabel" Text="📡 Азбука Морзе (English)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBox x:Name="RightMorseText" 
                             PlaceholderText="Здесь появится код Морзе..."
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontSize="13"
                             Background="#2D2D2D"
                             Foreground="#FFD700"
                             FontFamily="Consolas"
                             Height="70"/>
                    <Button Content="📋 Копировать Морзе" Click="CopyRightMorse_Click" 
                            Height="35" Padding="15,5" Background="#2D2D2D" Foreground="White"
                            HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- НИЖНИЙ РЯД: Двоичный код (Binary) -->
            <Border Grid.Row="3" Grid.Column="0" Background="#1E1E1E" Padding="15" CornerRadius="8" Margin="0,0,10,0">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="LeftBinaryLabel" Text="💻 Двоичный код (Русский)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBox x:Name="LeftBinaryText" 
                             PlaceholderText="Здесь появится binary-код..."
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontSize="13"
                             Background="#2D2D2D"
                             Foreground="#00E5FF"
                             FontFamily="Consolas"
                             Height="70"/>
                    <Button Content="📋 Копировать Binary" Click="CopyLeftBinary_Click" 
                            Height="35" Padding="15,5" Background="#2D2D2D" Foreground="White" 
                            HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="2" Background="#1E1E1E" Padding="15" CornerRadius="8" Margin="10,0,0,0">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="RightBinaryLabel" Text="💻 Двоичный код (English)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBox x:Name="RightBinaryText" 
                             PlaceholderText="Здесь появится binary-код..."
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontSize="13"
                             Background="#2D2D2D"
                             Foreground="#00E5FF"
                             FontFamily="Consolas"
                             Height="70"/>
                    <Button Content="📋 Копировать Binary" Click="CopyRightBinary_Click" 
                            Height="35" Padding="15,5" Background="#2D2D2D" Foreground="White"
                            HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>