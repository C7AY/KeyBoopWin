			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Models\vosk-model-small-ru-0.22\ivector\final.dubm">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
