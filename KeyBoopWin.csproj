	<ItemGroup>
		<Folder Include="Models\" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="Assets\app.ico">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<Target Name="CopyWinUIBootstrap" AfterTargets="Publish">
		<ItemGroup>
			<!-- Берем файлы из папки, где они точно есть (OutDir), и кладем в PublishDir -->
			<BootstrapFiles Include="$(OutDir)Microsoft.WindowsAppRuntime.Bootstrap.dll" />
			<BootstrapFiles Include="$(OutDir)Microsoft.WindowsAppRuntime.Bootstrap.net8.dll" />
			<BootstrapFiles Include="$(OutDir)Microsoft.WindowsAppRuntime.Bootstrap.net.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(BootstrapFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
		<Message Text="✅ Bootstrap-файлы WinUI 3 успешно скопированы в папку публикации!" Importance="high" />
	</Target>
</Project>