<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>KeyBoopWin</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>false</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<Nullable>enable</Nullable>
		<NoWarn>NU1605;NU1701</NoWarn>
		<NoWarn>CA1416;NU1605;NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="AreaSelectorWindow.xaml" />
		<None Remove="ConverterWindow.xaml" />
		<None Remove="OverlayWindow.xaml" />
		<None Remove="Resources\WindowsAppRuntimeInstall-x64.exe" />
		<None Remove="Resources\WindowsAppRuntimeInstall-x86.exe" />
		<None Remove="TranslatorWindow.xaml" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\SplashScreen.scale-200.png" />
