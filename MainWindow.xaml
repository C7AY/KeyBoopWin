<Window
       x:Class="KeyBoopWin.MainWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="KeyBoopWin">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,5">
        <TextBlock Grid.Row="0" Text="🎤 Голосовой ввод"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                   <TextBlock Text="Транскрибация голоса в текст, поддерживается русский и английский" 
           Foreground="Gray" FontSize="12" Margin="0,2,0,0"/>
                   
            </StackPanel>

        <!-- Row 1: Статус и управление языком -->
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="15">
                <TextBlock Text="Статус:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Ожидание инициализации..." 
                           Foreground="Gray" VerticalAlignment="Center"/>

                <!-- НОВАЯ КНОПКА: Конвертер регистров -->
                <Button Content="🌐 Переводчик" Click="OpenTranslator_Click" 
        Margin="10,0,0,0"/>

                <!-- НОВАЯ КНОПКА: Конвертер регистров -->
                <Button Content="🔤 Конвертер регистров" Click="OpenConverter_Click" 
                        Margin="10,0,0,0"/>

                <!-- СДВИНУТАЯ ВПРАВО КНОПКА: Настройки -->
                <Button Content="⚙️ Настройки" Click="OpenSettings_Click" 
                        Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text=" Язык распознавания:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="LanguageSelector" Width="150" SelectedIndex="0" 
                          SelectionChanged="LanguageSelector_SelectionChanged">
                    <ComboBoxItem Content="ru Русский" Tag="ru"/>
                    <ComboBoxItem Content="en English" Tag="en"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Row 2: Голосовой ввод + История -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">

                <!-- === СЕКЦИЯ: Голосовой ввод === -->
                <Border Background="#1E1E1E" Padding="15" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <!--<TextBlock Text="🎤 Голосовой ввод" FontSize="18" FontWeight="Bold"/>-->

                        <TextBox x:Name="RecognizedText" 
                        PlaceholderText="Здесь появится распознанный текст..." 
                        Height="100" 
                        TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         Background="#2D2D2D"
                         Foreground="White"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="StartVoiceBtn" Content="▶️ Запись" 
                                    Click="StartVoice_Click" Background="#0078D4" Foreground="White"/>
                            <Button x:Name="StopVoiceBtn" Content="⏹️ Стоп" 
                                    Click="StopVoice_Click" IsEnabled="False" Background="#D40000" Foreground="White"/>
                            <Button x:Name="PreviewMicBtn" Content="🎧 Тест микрофона" 
                                    Click="PreviewMic_Click"/>
                            <Button Content="📋 Копировать текущее" 
                                    Click="CopyToClipboard_Click" Margin="10,0,0,0"/>
                            <Button Content="➕ Добавить в историю" 
                                    Click="AddToHistory_Click" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Ползунок громкости и шумоподавление -->
                        <Border Background="#2D2D2D" Padding="10" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔊 Усиление микрофона:" 
                                               FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GainValueText" Text=" 1.0x" 
                                               FontSize="12" Foreground="#00FF00" 
                                               FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Slider x:Name="MicGainSlider" 
                                        Minimum="0.5" Maximum="3.0" Value="1.0" 
                                        StepFrequency="0.1"
                                        ValueChanged="MicGainSlider_ValueChanged"
                                        Width="300" HorizontalAlignment="Left"/>

                                <!-- Чекбокс шумоподавления -->
                                <CheckBox x:Name="NoiseSuppressionCheckBox" 
                                  Content=" Подавление шума (требуется 2 сек тишины)" 
                                  Margin="0,10,0,0"
                                  Checked="NoiseSuppression_Checked"
                                  Unchecked="NoiseSuppression_Unchecked"
                                  Foreground="White"/>

                                <!-- Чекбокс обучения шуму -->
                                <ProgressBar x:Name="NoiseLearningBar" 
                                     Height="10" 
                                     Minimum="0" Maximum="100" Value="0"
                                     Visibility="Collapsed"
                                     Margin="0,5,0,0"
                                     Background="#2D2D2D"
                                     Foreground="#FFA500"/>
                            </StackPanel>
                        </Border>

                        <!-- Индикатор уровня звука -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="📊 Уровень звука:" FontSize="12" Foreground="#AAAAAA"/>
                            <ProgressBar x:Name="AudioLevelBar" 
                                         Height="15" 
                                         Minimum="0" Maximum="1" Value="0"
                                         Background="#2D2D2D"
                                         Foreground="#00FF00"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- === СЕКЦИЯ: История сессии === -->
                <Border Background="#1E1E1E" Padding="15" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜 История сессии" FontSize="18" FontWeight="Bold"/>
                            <Button Content="🗑️ Очистить историю" 
                                    Click="ClearHistory_Click" 
                                    Margin="20,0,0,0"
                                    Background="#D40000" Foreground="White"/>
                        </StackPanel>

                        <TextBlock Text="Текст автоматически добавляется при остановке записи или смене языка (удаляется после перезапуска)" 
                                   FontSize="11" Foreground="#888888" FontStyle="Italic"/>

                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2D2D2D" Padding="10" Margin="0,5" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Timestamp}" 
                                                           FontSize="10" Foreground="#888888"/>
                                                <TextBlock Text="{Binding Text}" 
                                                           TextWrapping="Wrap" 
                                                           Foreground="White" 
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="📋" 
                                                    Tag="{Binding Text}"
                                                    Click="CopyHistoryItem_Click"
                                                    Margin="10,0,0,0"
                                                    Padding="10,5"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>