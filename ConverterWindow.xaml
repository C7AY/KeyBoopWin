<Window
    x:Class="KeyBoopWin.ConverterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="🔠 Конвертер регистров">

    <Grid Padding="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🔠 Конвертер регистров" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Преобразование текста в различные регистры" 
                       Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Два поля рядом -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Исходный текст -->
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Исходный текст:" FontWeight="SemiBold" FontSize="14"/>
                <TextBox x:Name="InputText" 
                         PlaceholderText="Введите или вставьте текст сюда..."
                         Height="200" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         FontSize="14"
                         Background="#2D2D2D"
                         Foreground="White"/>
            </StackPanel>

            <!-- Правая колонка: Результат -->
            <StackPanel Grid.Column="2" Spacing="8">
                <TextBlock Text="Результат:" FontWeight="SemiBold" FontSize="14"/>
                <TextBox x:Name="OutputText" 
                         PlaceholderText="Здесь появится результат..."
                         Height="200" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         FontSize="14"
                         Background="#1E1E1E"
                         Foreground="#00FF00"/>
            </StackPanel>
        </Grid>

        <!-- Кнопки конвертации (сразу под полями, отступ 15px как между полями) -->
        <StackPanel Grid.Row="2" Spacing="10">
            <TextBlock Text="Выберите регистр:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

            <!-- Первый ряд: все кнопки конвертации -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Content="🔤 ВЕРХНИЙ" Click="ToUpperCase_Click" Width="140" Height="40"/>
                <Button Content="🔡 нижний" Click="ToLowerCase_Click" Width="140" Height="40"/>
                <Button Content="🔠 Заглавные" Click="ToTitleCase_Click" Width="140" Height="40"/>
                <Button Content="🔀 пЕрЕвОрОт" Click="ToToggleCase_Click" Width="140" Height="40"/>
                <Button Content="🎲 Случайный" Click="ToRandomCase_Click" Width="140" Height="40"/>
                <Button Content="📝 Предложение" Click="ToSentenceCase_Click" Width="140" Height="40"/>
            </StackPanel>

            <!-- Второй ряд: Копировать и Очистить (по центру) -->
            <StackPanel Orientation="Horizontal" 
                        Spacing="10" 
                        HorizontalAlignment="Center">
                <Button Content="📋 Копировать" Click="CopyResult_Click" Width="140" Height="40"/>
                <Button Content="🗑️ Очистить" Click="ClearAll_Click" Width="140" Height="40"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>